{
  "manifest_version": 3,
  "name": "Browser Harness",
  "version": "0.11.1",
  "description": "Raw CDP relay and side panel for an already-open Chrome.",
  "permissions": ["debugger", "tabs", "tabGroups", "sidePanel", "storage", "offscreen", "scripting", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "Browser Harness",
    "default_icon": {
      "16": "icons/gray16.png",
      "32": "icons/gray32.png"
    }
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Open Browser Harness side panel"
    },
    "open-chats": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open Browser Harness chats"
    }
  },
  "icons": {
    "16": "icons/gray16.png",
    "32": "icons/gray32.png",
    "128": "icons/gray128.png"
  }
}
